# Gemini text/function-calling and text-only fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
VISIONGUIDE_TIMEZONE=Asia/Kolkata

# Local semantic matcher used when Gemini function calling is unavailable.
VISIONGUIDE_LOCAL_SEMANTIC=1
VISIONGUIDE_SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2
VISIONGUIDE_SEMANTIC_THRESHOLD=0.57

# Google OAuth desktop client JSON path and local token-store directory.
GOOGLE_OAUTH_CLIENT_FILE=credentials/google_oauth_client.json
GOOGLE_TOKEN_DIR=data/google_tokens

# Absolute path when Tesseract is not on PATH.
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

# Wake-word model configuration. Listening remains disarmed until the user enables it.
WAKE_WORD_MODEL=models/wakeword/hey_arthur.onnx
WAKE_WORD_THRESHOLD=0.60

# API service settings: development should bind to loopback only.
VISIONGUIDE_API_HOST=127.0.0.1
VISIONGUIDE_API_PORT=8000
VISIONGUIDE_API_TOKEN=

# Windows network interface name shown by `netsh interface show interface`.
VISIONGUIDE_WIFI_ADAPTER=Wi-Fi

# Google Maps Platform key. Restrict it to the Maps APIs used by this app.
# Cloud Vision uses a separate Cloud key below; Translation and Natural Language use OAuth.
GOOGLE_MAPS_API_KEY=
VISIONGUIDE_DEFAULT_LOCATION=

# Application-side cost guards (per UTC day, per device). These complement, not replace,
# Google Cloud billing budgets and API quotas. Lower values reduce accidental usage.
VISIONGUIDE_GOOGLE_DAILY_ROUTE_CAP=20
VISIONGUIDE_GOOGLE_DAILY_WEATHER_CAP=20
VISIONGUIDE_GOOGLE_DAILY_VISUAL_CAP=5
VISIONGUIDE_GOOGLE_DAILY_GEOCODE_CAP=30

# Optional local face-embedding enhancement; LBPH remains available without DeepFace.
VISIONGUIDE_FACE_EMBEDDING_MODEL=Facenet512
VISIONGUIDE_FACE_COSINE_THRESHOLD=0.30

# Optional separate key for Google Cloud Vision Web Detection. Restrict it to Cloud Vision API;
# this key is separate from the Maps Platform key. Translation and Natural Language use scoped OAuth.
GOOGLE_CLOUD_API_KEY=
# Optional override if you create a dedicated Cloud Vision-only key.
GOOGLE_VISION_API_KEY=

# Conservative application-side daily caps (UTC, per local device). Cloud APIs also have
# their own quotas/billing. Set a cap to 0 to disable that endpoint locally.
VISIONGUIDE_GOOGLE_DAILY_PLACES_CAP=20
VISIONGUIDE_GOOGLE_DAILY_AIR_QUALITY_CAP=10
VISIONGUIDE_GOOGLE_DAILY_POLLEN_CAP=10
VISIONGUIDE_GOOGLE_DAILY_TIMEZONE_CAP=30
VISIONGUIDE_GOOGLE_DAILY_ROADS_CAP=10
VISIONGUIDE_GOOGLE_DAILY_GEOLOCATION_CAP=3
VISIONGUIDE_GOOGLE_DAILY_TRANSLATION_CAP=30
VISIONGUIDE_GOOGLE_DAILY_LANGUAGE_CAP=30

TESSERACT_CMD=